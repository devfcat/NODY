<Window x:Class="Nody.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NODY" Width="1280" Height="800" MinWidth="900" MinHeight="500"
        Icon="Images/icon.ico"
        FontFamily="Segoe UI"
        Background="{DynamicResource AppBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Activated="Window_Activated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ───────── 엑셀 스타일 리본 ───────── -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 탭 줄: 로고 + 홈 -->
            <Border Grid.Row="0" Background="{DynamicResource RibbonTabBarBg}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="다크 모드" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgMuted}"/>
                        <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSwitch}"
                                      ToolTip="라이트 / 다크 테마 전환"
                                      Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" Padding="8,0">
                            <Image Source="/Images/NODY.png"
                                   Height="12"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <RadioButton x:Name="HomeTab" Style="{StaticResource RibbonTab}"
                                     GroupName="RibbonTabs" Content="홈" IsChecked="True"
                                     Checked="HomeTab_Checked"/>
                        <RadioButton x:Name="InfoTab" Style="{StaticResource RibbonTab}"
                                     GroupName="RibbonTabs" Content="정보"
                                     Checked="InfoTab_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 홈 명령 그룹 -->
            <Border x:Name="HomeRibbon" Grid.Row="1" Background="{DynamicResource RibbonBg}"
                    BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,0,0,1"
                    Padding="4,4,8,2">
                <StackPanel Orientation="Horizontal">

                    <!-- 파일 -->
                    <StackPanel Margin="2,0,4,0">
                        <Button Style="{StaticResource RibbonButton}"
                                ToolTip="프로젝트(작업) 폴더를 선택합니다. 새 폴더를 만들어도 됩니다."
                                Click="OpenProject_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="프로젝트 열기"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="파일"/>
                    </StackPanel>

                    <Border Width="1" Margin="4,2,4,16" Background="{DynamicResource TopBarBorder}"/>

                    <!-- 노드 -->
                    <StackPanel Margin="2,0,4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource RibbonButton}"
                                    ToolTip="새 엑셀 파일과 노드를 만듭니다."
                                    Click="AddNode_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE710;"/>
                                    <TextBlock Style="{StaticResource RibbonCaption}" Text="노드 생성"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}"
                                    ToolTip="선택한 노드 삭제 (Delete)"
                                    Click="DeleteNode_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE74D;"/>
                                    <TextBlock Style="{StaticResource RibbonCaption}" Text="삭제하기"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="노드"/>
                    </StackPanel>

                    <Border Width="1" Margin="4,2,4,16" Background="{DynamicResource TopBarBorder}"/>

                    <!-- 플로우 -->
                    <StackPanel Margin="2,0,4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton x:Name="DrawFlowToggle" Style="{StaticResource RibbonToggle}"
                                          ToolTip="시작 노드 → 도착 노드 순서로 클릭해 선을 긋습니다. (Esc: 종료)"
                                          Click="DrawFlow_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE71B;"/>
                                    <TextBlock Style="{StaticResource RibbonCaption}" Text="플로우 긋기"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="DeleteFlowToggle" Style="{StaticResource RibbonToggle}"
                                          ToolTip="지우려는 선을 클릭합니다. (Esc: 종료)"
                                          Click="DeleteFlow_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE711;"/>
                                    <TextBlock Style="{StaticResource RibbonCaption}" Text="플로우 삭제"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="플로우"/>
                    </StackPanel>

                    <Border Width="1" Margin="4,2,4,16" Background="{DynamicResource TopBarBorder}"/>

                    <!-- 내보내기 -->
                    <StackPanel Margin="2,0,4,0">
                        <Button Style="{StaticResource RibbonButton}"
                                ToolTip="프로젝트 폴더 전체를 zip 으로 저장합니다."
                                Click="Export_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE72D;"/>
                                <TextBlock Style="{StaticResource RibbonCaption}" Text="프로젝트 내보내기"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="공유"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 정보 리본: 버전 한 줄 -->
            <Border x:Name="InfoRibbon" Grid.Row="1" Visibility="Collapsed" MinHeight="72"
                    Background="{DynamicResource RibbonBg}"
                    BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,0,0,1"
                    Padding="16,4,8,2">
                <TextBlock x:Name="AboutVersionLine" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- ───────── 캔버스 ───────── -->
        <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" Focusable="True"
              Background="{DynamicResource CanvasBg}"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
              MouseDown="Viewport_MouseDown"
              MouseUp="Viewport_MouseUp"
              MouseMove="Viewport_MouseMove"
              MouseWheel="Viewport_MouseWheel">

            <!-- 점 격자 (패닝/줌을 따라 움직인다) -->
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush x:Name="GridBrush" TileMode="Tile"
                                  ViewportUnits="Absolute" Viewport="0,0,40,40">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,40,40"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="{DynamicResource GridDot}">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="20,20" RadiusX="1.6" RadiusY="1.6"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 월드 (이동/확대 적용 대상) : 선 → 임시선 → 노드 순서로 쌓임 -->
            <Canvas x:Name="World" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas x:Name="FlowLayer"/>
                <Canvas x:Name="OverlayLayer" IsHitTestVisible="False"/>
                <Canvas x:Name="NodeLayer"/>
            </Canvas>

            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" FontSize="15" IsHitTestVisible="False"
                       Foreground="{DynamicResource FgMuted}"/>

            <!-- 노드 미니맵 (창 비율과 동일) -->
            <Border x:Name="MinimapHost"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="14" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource NodeBg}"
                    BorderBrush="{DynamicResource TopBarBorder}"
                    ClipToBounds="True" Cursor="Hand"
                    MouseLeftButtonDown="Minimap_MouseLeftButtonDown"
                    MouseMove="Minimap_MouseMove"
                    MouseLeftButtonUp="Minimap_MouseLeftButtonUp"
                    MouseWheel="Minimap_MouseWheel">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"/>
                </Border.Effect>
                <Canvas x:Name="MinimapCanvas" IsHitTestVisible="False"/>
            </Border>
        </Grid>

        <!-- ───────── 상태바 ───────── -->
        <Border Grid.Row="2" Padding="12,4"
                Background="{DynamicResource TopBarBg}"
                BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusZoom" DockPanel.Dock="Right" Margin="16,0,0,0" FontSize="12"
                           Foreground="{DynamicResource FgMuted}" Text="100%"/>
                <TextBlock x:Name="StatusSave" DockPanel.Dock="Right" Margin="16,0,0,0" FontSize="12"
                           Foreground="{DynamicResource FgMuted}"/>
                <TextBlock x:Name="StatusMain" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FgMuted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
