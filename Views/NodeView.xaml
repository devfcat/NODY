<UserControl x:Class="Nody.Views.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="더블클릭: 파일 열기  /  우클릭: 이름 수정">
    <UserControl.Resources>
        <!-- 타입 드롭다운 버튼 -->
        <Style x:Key="TypeButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Padding="8,3"
                                Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource NodeBorder}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NodeSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 드롭다운 항목 -->
        <Style x:Key="PopupItemStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Padding="10,5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="8" BorderThickness="2"
            Background="{DynamicResource NodeBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="AccentBar" CornerRadius="6,6,0,0"/>

            <Grid Grid.Row="1" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 노드 이름 (= 엑셀 파일명) -->
                <Grid Grid.Row="0" Height="22">
                    <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="NameBox" Visibility="Collapsed" FontSize="13"
                             Padding="2,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBg}"
                             Foreground="{DynamicResource Fg}"
                             CaretBrush="{DynamicResource Fg}"
                             BorderBrush="{DynamicResource NodeSelected}"
                             KeyDown="NameBox_KeyDown"
                             LostKeyboardFocus="NameBox_LostKeyboardFocus"/>
                </Grid>

                <!-- 타입 드롭다운 -->
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Button x:Name="TypeButton" Style="{StaticResource TypeButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="110" Click="TypeButton_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="▾" Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                            <Ellipse x:Name="TypeDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TypeText" FontSize="12" Foreground="{DynamicResource Fg}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <Popup x:Name="TypePopup" PlacementTarget="{Binding ElementName=TypeButton}"
                           Placement="Bottom" StaysOpen="False" Closed="TypePopup_Closed">
                        <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource NodeBorder}"
                                BorderThickness="1" Padding="3">
                            <StackPanel MinWidth="130">
                                <Button Style="{StaticResource PopupItemStyle}" Tag="Dialogue" Click="TypeItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource DialogueAccent}"/>
                                        <TextBlock Text="대사 파일" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PopupItemStyle}" Tag="Choice" Click="TypeItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource ChoiceAccent}"/>
                                        <TextBlock Text="선택지 파일" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 스크립트 미리보기 -->
                <StackPanel x:Name="PreviewPanel" Grid.Row="2" ClipToBounds="True"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
