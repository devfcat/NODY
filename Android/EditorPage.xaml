<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Nody.AndroidApp.EditorPage"
             Title="NODY"
             BackgroundColor="#F3F2F1">
    <Grid RowDefinitions="Auto,*,Auto">
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="Toolbar" Padding="8,8" Spacing="6"/>
        </ScrollView>

        <GraphicsView x:Name="CanvasView" Grid.Row="1"
                      StartInteraction="OnStart"
                      DragInteraction="OnDrag"
                      EndInteraction="OnEnd"
                      EndHoverInteraction="OnHoverEnd"/>

        <Label x:Name="StatusLabel" Grid.Row="2" Margin="12,6" FontSize="12"
               TextColor="#6B7280" LineBreakMode="TailTruncation"/>
    </Grid>
</ContentPage>
